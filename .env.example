# Configuração da Plataforma SaaS - Gisele Lourenço & DaviLiz
PORT=3000

# ==============================================================================
# 1. AUTENTICAÇÃO ADMIN & SESSÃO (OBRIGATÓRIO TROCAR EM PRODUÇÃO)
# ==============================================================================
ADMIN_EMAIL=admin@giselelourenco.com.br
ADMIN_PASSWORD=Gisele@2026
SESSION_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria_2026

# ==============================================================================
# 2. SUPABASE (BANCO DE DADOS + STORAGE GRÁTIS PARA VERCEL / NETLIFY)
# ==============================================================================
# Pegue em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clube-media

# ==============================================================================
# 3. INTEGRAÇÃO ASAAS (https://www.asaas.com)
# ==============================================================================
# Use "sandbox" para testes ou "production" para produção
ASAAS_ENVIRONMENT=sandbox

# Insira sua chave de API do Asaas ($aact_...)
# Caso esteja vazia, a plataforma opera em Modo Demonstração Interativo
ASAAS_API_KEY=

# Token de segurança para validar Webhooks recebidos em /api/asaas/webhook
ASAAS_WEBHOOK_TOKEN=segredo_webhook_gisele_daviliz_2026
